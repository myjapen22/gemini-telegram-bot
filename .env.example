TELEGRAM_BOT_TOKEN=replace_with_botfather_token
GEMINI_API_KEY=replace_with_google_ai_studio_key
# Comma-separated numeric Telegram user IDs. Add more IDs when needed.
ALLOWED_TELEGRAM_USER_IDS=7589831382
GEMINI_MODEL=gemini-3.8-flash-tts
GEMINI_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
DEFAULT_VOICE=Kore
DEFAULT_SPEED=normal
MAX_TEXT_LENGTH=4000
# Optional ElevenLabs API key pool. Comma-separated list takes precedence over the single-key fallback.
# ELEVENLABS_API_KEYS=replace_with_key_1,replace_with_key_2
# ELEVENLABS_API_KEY=replace_with_single_key
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_LOCAL_CHAR_QUOTA_PER_KEY=10000
# Optional exact-literal substitutions for clone synthesis only; leave blank to disable.
# VOICE_CLONE_PRONUNCIATION_OVERRIDES={"ကျွန်တော်":"ကျနော်"}
